# Copy to .env for local use. NEVER commit .env
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
PORT=8000
# Leave empty to use SQLite locally. On the live server set a PostgreSQL URL (e.g. from Neon).
DATABASE_URL=
# Optional but needed for calls over mobile data / different networks (free TURN: metered.ca)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
